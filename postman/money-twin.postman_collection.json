{
  "info": {
    "name": "Money Twin API",
    "description": "Every Money Twin API route. Run the folders in order.\n\nAuth: in local development, `1. Sign in (dev login)` signs in with an email only (needs AUTH_DEV_LOGIN=true in web/.env.local). Postman keeps the session cookie for the other requests. Real users sign in with Google in the app.\n\nPrivacy: transactions are saved without the raw bank description. A request that includes `description` (or any unknown field) is rejected with 400.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "postman-tester@example.com"
    },
    {
      "key": "csrfToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Sign in (dev login)",
      "item": [
        {
          "name": "Get CSRF token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "csrf"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('csrfToken', pm.response.json().csrfToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in with email (dev only)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/callback/dev-login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "callback",
                "dev-login"
              ]
            },
            "description": "Local development only. Sets the session cookie.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "csrfToken",
                  "value": "{{csrfToken}}"
                },
                {
                  "key": "email",
                  "value": "{{email}}"
                },
                {
                  "key": "callbackUrl",
                  "value": "{{baseUrl}}/account"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in (not sent back to an error page)', () => pm.expect(pm.response.code).to.be.below(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "session"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('session has the user id', () => {",
                  "  const s = pm.response.json();",
                  "  pm.expect(s.user.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(s.user.id).to.match(/^[a-f0-9]{24}$/);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Me",
      "item": [
        {
          "name": "Get my profile and counts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('counts present', () => pm.expect(pm.response.json().counts).to.have.keys('transactions', 'overrides'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Transactions",
      "item": [
        {
          "name": "Clear my transactions (start fresh)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Save categorised transactions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ]
            },
            "description": "Body: { transactions: [...] }, up to 5,000 per request. `fingerprint` is a SHA-256 hex hash made in the browser.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactions\": [\n    {\n      \"fingerprint\": \"3b5f1c0a6d2e4f8a9b7c1d3e5f7a9b1c3d5e7f9a1b3c5d7e9f1a3b5c7d9e1f3a\",\n      \"datetime\": \"2026-08-03T13:10:00\",\n      \"amount\": 60,\n      \"type\": \"DR\",\n      \"balance\": 4940,\n      \"channel\": \"UPI\",\n      \"counterparty\": \"Manjunath S\",\n      \"category\": \"Paid to People\",\n      \"confidence\": \"low\"\n    },\n    {\n      \"fingerprint\": \"4c6a2d1b7e3f5a9b8c2d4e6f8a1b3c5d7e9f2a4b6c8d1e3f5a7b9c2d4e6f8a1b\",\n      \"datetime\": \"2026-08-04T13:10:00\",\n      \"amount\": 45,\n      \"type\": \"DR\",\n      \"balance\": 4955,\n      \"channel\": \"UPI\",\n      \"counterparty\": \"MANJUNATH  S\",\n      \"category\": \"Food & Dining\",\n      \"confidence\": \"low\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created', () => pm.response.to.have.status(201));",
                  "pm.test('2 inserted', () => pm.expect(pm.response.json().inserted).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Save again with overlap (dedupe)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ]
            },
            "description": "An overlapping statement: the known row is matched on its fingerprint, only the new one is inserted.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactions\": [\n    {\n      \"fingerprint\": \"3b5f1c0a6d2e4f8a9b7c1d3e5f7a9b1c3d5e7f9a1b3c5d7e9f1a3b5c7d9e1f3a\",\n      \"datetime\": \"2026-08-03T13:10:00\",\n      \"amount\": 60,\n      \"type\": \"DR\",\n      \"balance\": 4940,\n      \"channel\": \"UPI\",\n      \"counterparty\": \"Manjunath S\",\n      \"category\": \"Paid to People\",\n      \"confidence\": \"low\"\n    },\n    {\n      \"fingerprint\": \"5d7b3e2c8f4a6b1c9d3e5f7a2b4c6d8e1f3a5b7c9d2e4f6a8b1c3d5e7f9a2b4c\",\n      \"datetime\": \"2026-08-09T13:10:00\",\n      \"amount\": 250,\n      \"type\": \"DR\",\n      \"balance\": 4750,\n      \"channel\": \"UPI\",\n      \"counterparty\": \"Swiggy\",\n      \"category\": \"Food & Dining\",\n      \"confidence\": \"high\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('only the new row inserted', () => pm.expect(pm.response.json()).to.include({ received: 2, inserted: 1 }));"
                ]
              }
            }
          ]
        },
        {
          "name": "List my transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('3 transactions, newest first', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.total).to.eql(3);",
                  "  pm.expect(b.transactions[0].counterparty).to.eql('Swiggy');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List with a date range",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?from=2026-08-01&to=2026-08-05&limit=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-08-01"
                },
                {
                  "key": "to",
                  "value": "2026-08-05"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2 in range', () => pm.expect(pm.response.json().total).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Months with data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/months",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "months"
              ]
            },
            "description": "Every month with saved transactions (India time), oldest first, with what was spent and what came in. Used by the Replay month picker. Friend and self-transfer money is neither spent nor received."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('August 2026 listed with its totals', () => {",
                  "  const m = pm.response.json().months;",
                  "  const aug = m.find((x) => x.month === '2026-08');",
                  "  pm.expect(aug).to.be.an('object');",
                  "  pm.expect(aug.count).to.be.above(0);",
                  "  pm.expect(aug).to.have.all.keys('month', 'count', 'spent', 'received');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rejected: raw description included",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ]
            },
            "description": "The API refuses raw statement text.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactions\": [\n    {\n      \"fingerprint\": \"5d7b3e2c8f4a6b1c9d3e5f7a2b4c6d8e1f3a5b7c9d2e4f6a8b1c3d5e7f9a2b4c\",\n      \"datetime\": \"2026-08-09T13:10:00\",\n      \"amount\": 250,\n      \"type\": \"DR\",\n      \"balance\": 4750,\n      \"channel\": \"UPI\",\n      \"counterparty\": \"Swiggy\",\n      \"category\": \"Food & Dining\",\n      \"confidence\": \"low\",\n      \"description\": \"UPI/Swiggy/612345678901/Paid\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Payee labels (merchant overrides)",
      "item": [
        {
          "name": "Label payees (Teach your twin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/overrides",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "overrides"
              ]
            },
            "description": "Upserts labels and re-labels matching saved transactions (name compared without case or spaces). Family becomes Family Support (money in) or Sent to Family (money out); Self is a transfer; Friend is a split/loan: `friendMode` \"lend\" (they owe it back) or \"share\" (your share of outings, counted as your spending as Food/Entertainment). Income reasons (Salary/Stipend, Scholarship, Refund, Sold something, Other income) are valid categories. Optional `nickname` (max 40) is shown instead of the UPI name; omit to keep it, null to remove it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"overrides\": [\n    {\n      \"counterparty\": \"Manjunath S\",\n      \"category\": \"Food\",\n      \"nickname\": \"Canteen uncle\"\n    },\n    {\n      \"counterparty\": \"Ramesh Kumar\",\n      \"category\": \"Family\"\n    },\n    {\n      \"counterparty\": \"My Own Name\",\n      \"category\": \"Self\"\n    },\n    {\n      \"counterparty\": \"Arjun P\",\n      \"category\": \"Friend\",\n      \"friendMode\": \"lend\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('4 saved', () => pm.expect(pm.response.json().saved).to.eql(4));",
                  "pm.test('both Manjunath S rows re-labelled', () => pm.expect(pm.response.json().relabelledTransactions).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "List my labels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/overrides",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "overrides"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('4 labels', () => pm.expect(pm.response.json().overrides.length).to.eql(4));",
                  "pm.test('nickname returned', () => {",
                  "  const m = pm.response.json().overrides.find(o => o.counterparty === 'Manjunath S');",
                  "  pm.expect(m.nickname).to.eql('Canteen uncle');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Forget one label",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/overrides/My%20Own%20Name",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "overrides",
                "My%20Own%20Name"
              ]
            },
            "description": "Key = the payee name (case and spaces ignored), URL-encoded."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Forget a label that doesn't exist",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/overrides/Nobody",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "overrides",
                "Nobody"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Twin (character, Money Skills book, replay progress)",
      "item": [
        {
          "name": "Save my twin",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/twin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "twin"
              ]
            },
            "description": "Saves the twin to the account so it follows the player across devices. Parts left out are kept; null clears a part.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"character\": {\n    \"type\": \"student\",\n    \"name\": \"Kavya\",\n    \"city\": \"Pune\",\n    \"avatarSeed\": \"kavya-1\",\n    \"createdAt\": \"2026-09-10T10:00:00Z\",\n    \"updatedAt\": \"2026-09-10T10:00:00Z\"\n  },\n  \"skills\": {\n    \"xp\": 40,\n    \"learned\": {\n      \"impulse\": {\n        \"correct\": true,\n        \"at\": \"2026-09-11T09:00:00Z\"\n      },\n      \"delivery\": {\n        \"correct\": false,\n        \"at\": \"2026-09-11T09:05:00Z\"\n      }\n    },\n    \"updatedAt\": \"2026-09-11T09:05:00Z\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('saved', () => pm.expect(pm.response.json().twin.character.name).to.eql('Kavya'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Save replay progress",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"replay\": {\n    \"months\": {\n      \"2026-08\": {\n        \"grade\": \"B\",\n        \"score\": 74,\n        \"savingsKept\": 3200,\n        \"stats\": {\n          \"savings\": 40,\n          \"happiness\": 62,\n          \"stress\": 35,\n          \"goal\": 100\n        },\n        \"plan\": {\n          \"needs\": 50,\n          \"wants\": 30,\n          \"savings\": 20,\n          \"emergency\": 0\n        },\n        \"playedAt\": \"2026-09-12T10:00:00Z\"\n      }\n    },\n    \"updatedAt\": \"2026-09-12T10:00:00Z\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/twin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "twin"
              ]
            },
            "description": "Grades of replayed real months: results only (grade, score, savings kept, end stats, plan). Sending only `replay` keeps the character and skills."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('saved, character kept', () => {",
                  "  const t = pm.response.json().twin;",
                  "  pm.expect(t.replay.months['2026-08'].grade).to.eql('B');",
                  "  pm.expect(t.character).to.be.an('object');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rejected: transactions inside replay progress",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"replay\": {\n    \"months\": {\n      \"2026-08\": {\n        \"grade\": \"B\",\n        \"score\": 74,\n        \"savingsKept\": 3200,\n        \"stats\": {\n          \"savings\": 40,\n          \"happiness\": 62,\n          \"stress\": 35,\n          \"goal\": 100\n        },\n        \"plan\": {\n          \"needs\": 50,\n          \"wants\": 30,\n          \"savings\": 20,\n          \"emergency\": 0\n        },\n        \"playedAt\": \"2026-09-12T10:00:00Z\",\n        \"txns\": []\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/twin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "twin"
              ]
            },
            "description": "Replay progress never carries transactions; unknown fields are rejected."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400: results only', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my twin",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/twin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "twin"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('twin returned', () => {",
                  "  const t = pm.response.json().twin;",
                  "  pm.expect(t.character.city).to.eql('Pune');",
                  "  pm.expect(t.skills.xp).to.eql(40);",
                  "  pm.expect(t.replay.months['2026-08'].score).to.eql(74);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rejected: unknown character type",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/twin",
